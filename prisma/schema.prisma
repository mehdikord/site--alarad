// ─────────────────────────────────────────────────────────────────────────────
//  Alarad Shop — database schema (MySQL 8)
//
//  Conventions (Laravel-style):
//   • table names: snake_case, plural            → @@map("order_items")
//   • columns: snake_case                         → @map("created_at")
//   • every primary key + foreign key: BIGINT UNSIGNED
//   • every table has created_at / updated_at (TIMESTAMP)
//   • index names: <table>_<cols>_unique | _index | _foreign
//   • money is stored as integer Toman (INT UNSIGNED)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ═════════════════════════════ enums ═════════════════════════════

enum Audience {
  women
  men
  kids
  unisex
}

enum ProductStatus {
  draft
  active
  archived
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum CouponType {
  percent
  fixed
}

/// fulfilment lifecycle of an order
enum OrderStatus {
  pending // waiting for payment
  processing // paid (or COD) — being prepared
  shipped
  delivered
  cancelled
  returned
}

enum PaymentStatus {
  unpaid
  paid
  failed
  refunded
}

enum PaymentMethod {
  online
  cod
}

/// a single gateway transaction
enum TransactionStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum ShipmentStatus {
  pending
  preparing
  shipped
  delivered
  returned
}

// ═════════════════════════════ people ═════════════════════════════

/// system administrators — authenticate with phone + password
model Admin {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  phone       String    @unique(map: "admins_phone_unique") @db.VarChar(20)
  password    String    @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamp(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  media           Media[]
  statusHistories OrderStatusHistory[]
  shipments       Shipment[]

  @@map("admins")
}

/// storefront customers — authenticate with phone + OTP
model User {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name            String?   @db.VarChar(255)
  phone           String    @unique(map: "users_phone_unique") @db.VarChar(20)
  email           String?   @db.VarChar(255)
  isActive        Boolean   @default(true) @map("is_active")
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamp(0)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamp(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  addresses    Address[]
  orders       Order[]
  payments     Payment[]
  reviews      Review[]
  wishlists    Wishlist[]
  couponUsages CouponUsage[]

  @@map("users")
}

model OtpCode {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  phone     String    @db.VarChar(20)
  code      String    @db.VarChar(255) // bcrypt hash
  attempts  Int       @default(0) @db.UnsignedTinyInt
  ip        String?   @db.VarChar(45)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(0)
  usedAt    DateTime? @map("used_at") @db.Timestamp(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([phone], map: "otp_codes_phone_index")
  @@map("otp_codes")
}

// ═════════════════════════════ geography ═════════════════════════════

model Province {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  cities          City[]
  addresses       Address[]
  orders          Order[]
  shippingMethods ShippingMethodProvince[]

  @@map("provinces")
}

model City {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  provinceId BigInt   @map("province_id") @db.UnsignedBigInt
  name       String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  province  Province  @relation(fields: [provinceId], references: [id], onDelete: Cascade, map: "cities_province_id_foreign")
  addresses Address[]
  orders    Order[]

  @@index([provinceId], map: "cities_province_id_index")
  @@map("cities")
}

model Address {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt   @map("user_id") @db.UnsignedBigInt
  title         String?  @db.VarChar(100)
  receiverName  String   @map("receiver_name") @db.VarChar(255)
  receiverPhone String   @map("receiver_phone") @db.VarChar(20)
  provinceId    BigInt   @map("province_id") @db.UnsignedBigInt
  cityId        BigInt   @map("city_id") @db.UnsignedBigInt
  postalCode    String   @map("postal_code") @db.VarChar(10)
  address       String   @db.VarChar(500)
  unit          String?  @db.VarChar(255) // plaque / unit / floor
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "addresses_user_id_foreign")
  province Province @relation(fields: [provinceId], references: [id], map: "addresses_province_id_foreign")
  city     City     @relation(fields: [cityId], references: [id], map: "addresses_city_id_foreign")
  orders   Order[]

  @@index([userId], map: "addresses_user_id_index")
  @@index([provinceId], map: "addresses_province_id_index")
  @@index([cityId], map: "addresses_city_id_index")
  @@map("addresses")
}

// ═════════════════════════════ media library ═════════════════════════════

/// every uploaded file (product photos, category covers, …) lives here
model Media {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  adminId      BigInt?  @map("admin_id") @db.UnsignedBigInt
  disk         String   @default("uploads") @db.VarChar(32) // uploads | public
  path         String   @db.VarChar(500)
  url          String   @db.VarChar(500)
  fileName     String   @map("file_name") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int      @default(0) @db.UnsignedInt // bytes
  width        Int?     @db.UnsignedInt
  height       Int?     @db.UnsignedInt
  blurDataUrl  String?  @map("blur_data_url") @db.Text
  alt          String?  @db.VarChar(255)
  title        String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  admin         Admin?         @relation(fields: [adminId], references: [id], onDelete: SetNull, map: "media_admin_id_foreign")
  productImages ProductImage[]
  categories    Category[]

  @@index([adminId], map: "media_admin_id_index")
  @@index([mimeType], map: "media_mime_type_index")
  @@map("media")
}

// ═════════════════════════════ catalog ═════════════════════════════

/// nested (adjacency-list) product categories
model Category {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  parentId        BigInt?  @map("parent_id") @db.UnsignedBigInt
  imageId         BigInt?  @map("image_id") @db.UnsignedBigInt
  name            String   @db.VarChar(255)
  slug            String   @unique(map: "categories_slug_unique") @db.VarChar(191)
  tagline         String?  @db.VarChar(255)
  description     String?  @db.Text
  accent          String?  @db.VarChar(32)
  sortOrder       Int      @default(0) @map("sort_order") @db.UnsignedInt
  isActive        Boolean  @default(true) @map("is_active")
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "categories_parent_id_foreign")
  children Category[] @relation("CategoryTree")
  image    Media?     @relation(fields: [imageId], references: [id], onDelete: SetNull, map: "categories_image_id_foreign")
  products Product[]

  @@index([parentId], map: "categories_parent_id_index")
  @@index([imageId], map: "categories_image_id_index")
  @@map("categories")
}

model Color {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key       String   @unique(map: "colors_key_unique") @db.VarChar(50)
  name      String   @db.VarChar(100)
  hex       String   @db.VarChar(9)
  swatch    String?  @db.VarChar(255) // optional CSS gradient
  sortOrder Int      @default(0) @map("sort_order") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  variants ProductVariant[]
  images   ProductImage[]

  @@map("colors")
}

/// sizes are grouped into size sets (sock, tights, briefs, …)
model Size {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sizeGroup String   @map("size_group") @db.VarChar(50)
  key       String   @db.VarChar(50)
  label     String   @db.VarChar(100)
  note      String?  @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  variants ProductVariant[]

  @@unique([sizeGroup, key], map: "sizes_size_group_key_unique")
  @@map("sizes")
}

model Tag {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(100)
  slug      String   @unique(map: "tags_slug_unique") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  products ProductTag[]

  @@map("tags")
}

model Product {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId      BigInt        @map("category_id") @db.UnsignedBigInt
  name            String        @db.VarChar(255)
  slug            String        @unique(map: "products_slug_unique") @db.VarChar(191)
  subtitle        String?       @db.VarChar(255)
  description     String?       @db.Text
  audience        Audience      @default(women)
  price           Int           @db.UnsignedInt
  compareAtPrice  Int?          @map("compare_at_price") @db.UnsignedInt
  material        String?       @db.VarChar(255)
  care            String?       @db.VarChar(255)
  origin          String?       @db.VarChar(255)
  highlights      Json?
  status          ProductStatus @default(draft)
  isFeatured      Boolean       @default(false) @map("is_featured")
  rating          Decimal       @default(0) @db.Decimal(2, 1)
  reviewCount     Int           @default(0) @map("review_count") @db.UnsignedInt
  salesCount      Int           @default(0) @map("sales_count") @db.UnsignedInt
  popularity      Int           @default(0) @db.UnsignedInt
  metaTitle       String?       @map("meta_title") @db.VarChar(255)
  metaDescription String?       @map("meta_description") @db.VarChar(500)
  publishedAt     DateTime?     @map("published_at") @db.Timestamp(0)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "products_category_id_foreign")
  images     ProductImage[]
  variants   ProductVariant[]
  tags       ProductTag[]
  reviews    Review[]
  wishlists  Wishlist[]
  orderItems OrderItem[]

  @@index([categoryId], map: "products_category_id_index")
  @@index([status], map: "products_status_index")
  @@map("products")
}

model ProductTag {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  tagId     BigInt   @map("tag_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "product_tag_product_id_foreign")
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "product_tag_tag_id_foreign")

  @@unique([productId, tagId], map: "product_tag_product_id_tag_id_unique")
  @@index([tagId], map: "product_tag_tag_id_index")
  @@map("product_tag")
}

/// gallery image; optional color_id = photo shown when that colour is selected
model ProductImage {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  mediaId   BigInt   @map("media_id") @db.UnsignedBigInt
  colorId   BigInt?  @map("color_id") @db.UnsignedBigInt
  sortOrder Int      @default(0) @map("sort_order") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "product_images_product_id_foreign")
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade, map: "product_images_media_id_foreign")
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull, map: "product_images_color_id_foreign")

  @@index([productId], map: "product_images_product_id_index")
  @@index([mediaId], map: "product_images_media_id_index")
  @@index([colorId], map: "product_images_color_id_index")
  @@map("product_images")
}

/// sellable unit: product × colour × size, owns stock & SKU
model ProductVariant {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  colorId   BigInt?  @map("color_id") @db.UnsignedBigInt
  sizeId    BigInt?  @map("size_id") @db.UnsignedBigInt
  sku       String   @unique(map: "product_variants_sku_unique") @db.VarChar(64)
  price     Int?     @db.UnsignedInt // overrides product price when set
  stock     Int      @default(0) @db.UnsignedInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade, map: "product_variants_product_id_foreign")
  color      Color?      @relation(fields: [colorId], references: [id], onDelete: Restrict, map: "product_variants_color_id_foreign")
  size       Size?       @relation(fields: [sizeId], references: [id], onDelete: Restrict, map: "product_variants_size_id_foreign")
  orderItems OrderItem[]

  @@unique([productId, colorId, sizeId], map: "product_variants_product_id_color_id_size_id_unique")
  @@index([colorId], map: "product_variants_color_id_index")
  @@index([sizeId], map: "product_variants_size_id_index")
  @@map("product_variants")
}

model Review {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  productId       BigInt       @map("product_id") @db.UnsignedBigInt
  userId          BigInt?      @map("user_id") @db.UnsignedBigInt
  authorName      String       @map("author_name") @db.VarChar(255)
  rating          Int          @db.UnsignedTinyInt
  body            String       @db.Text
  status          ReviewStatus @default(pending)
  isVerifiedBuyer Boolean      @default(false) @map("is_verified_buyer")
  adminReply      String?      @map("admin_reply") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "reviews_product_id_foreign")
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull, map: "reviews_user_id_foreign")

  @@index([productId], map: "reviews_product_id_index")
  @@index([userId], map: "reviews_user_id_index")
  @@index([status], map: "reviews_status_index")
  @@map("reviews")
}

model Wishlist {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "wishlists_user_id_foreign")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "wishlists_product_id_foreign")

  @@unique([userId, productId], map: "wishlists_user_id_product_id_unique")
  @@index([productId], map: "wishlists_product_id_index")
  @@map("wishlists")
}

// ═════════════════════════════ marketing ═════════════════════════════

model Coupon {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  code           String     @unique(map: "coupons_code_unique") @db.VarChar(50)
  title          String     @db.VarChar(255)
  type           CouponType @default(percent)
  value          Int        @db.UnsignedInt // percent (1-100) or Toman
  maxDiscount    Int?       @map("max_discount") @db.UnsignedInt
  minOrderAmount Int?       @map("min_order_amount") @db.UnsignedInt
  usageLimit     Int?       @map("usage_limit") @db.UnsignedInt
  perUserLimit   Int?       @map("per_user_limit") @db.UnsignedInt
  usedCount      Int        @default(0) @map("used_count") @db.UnsignedInt
  startsAt       DateTime?  @map("starts_at") @db.Timestamp(0)
  expiresAt      DateTime?  @map("expires_at") @db.Timestamp(0)
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  usages CouponUsage[]
  orders Order[]

  @@map("coupons")
}

model CouponUsage {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  couponId  BigInt   @map("coupon_id") @db.UnsignedBigInt
  userId    BigInt?  @map("user_id") @db.UnsignedBigInt
  orderId   BigInt   @map("order_id") @db.UnsignedBigInt
  amount    Int      @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade, map: "coupon_usages_coupon_id_foreign")
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull, map: "coupon_usages_user_id_foreign")
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "coupon_usages_order_id_foreign")

  @@index([couponId], map: "coupon_usages_coupon_id_index")
  @@index([userId], map: "coupon_usages_user_id_index")
  @@index([orderId], map: "coupon_usages_order_id_index")
  @@map("coupon_usages")
}

model NewsletterSubscriber {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  contact   String   @unique(map: "newsletter_subscribers_contact_unique") @db.VarChar(191)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("newsletter_subscribers")
}

// ═════════════════════════════ shipping ═════════════════════════════

model ShippingMethod {
  id                    BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code                  String   @unique(map: "shipping_methods_code_unique") @db.VarChar(50)
  title                 String   @db.VarChar(255)
  description           String?  @db.VarChar(500)
  cost                  Int      @default(0) @db.UnsignedInt
  freeShippingThreshold Int?     @map("free_shipping_threshold") @db.UnsignedInt
  eta                   String?  @db.VarChar(255)
  supportsCod           Boolean  @default(false) @map("supports_cod")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order") @db.UnsignedInt
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  /// empty = available in every province
  provinces ShippingMethodProvince[]
  orders    Order[]
  shipments Shipment[]

  @@map("shipping_methods")
}

model ShippingMethodProvince {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  shippingMethodId BigInt   @map("shipping_method_id") @db.UnsignedBigInt
  provinceId       BigInt   @map("province_id") @db.UnsignedBigInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade, map: "shipping_method_province_shipping_method_id_foreign")
  province       Province       @relation(fields: [provinceId], references: [id], onDelete: Cascade, map: "shipping_method_province_province_id_foreign")

  @@unique([shippingMethodId, provinceId], map: "shipping_method_province_shipping_method_id_province_id_unique")
  @@index([provinceId], map: "shipping_method_province_province_id_index")
  @@map("shipping_method_province")
}

// ═════════════════════════════ orders ═════════════════════════════

model Order {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  code             String        @unique(map: "orders_code_unique") @db.VarChar(32) // public tracking code
  userId           BigInt?       @map("user_id") @db.UnsignedBigInt
  addressId        BigInt?       @map("address_id") @db.UnsignedBigInt
  shippingMethodId BigInt?       @map("shipping_method_id") @db.UnsignedBigInt
  couponId         BigInt?       @map("coupon_id") @db.UnsignedBigInt
  status           OrderStatus   @default(pending)
  paymentStatus    PaymentStatus @default(unpaid) @map("payment_status")
  paymentMethod    PaymentMethod @default(online) @map("payment_method")

  // receiver snapshot (kept even if the address book changes)
  receiverName  String  @map("receiver_name") @db.VarChar(255)
  receiverPhone String  @map("receiver_phone") @db.VarChar(20)
  provinceId    BigInt  @map("province_id") @db.UnsignedBigInt
  cityId        BigInt  @map("city_id") @db.UnsignedBigInt
  postalCode    String  @map("postal_code") @db.VarChar(10)
  address       String  @db.VarChar(500)
  unit          String? @db.VarChar(255)
  customerNote  String? @map("customer_note") @db.VarChar(1000)

  // money snapshot (Toman)
  itemCount     Int     @default(0) @map("item_count") @db.UnsignedInt
  subtotal      Int     @default(0) @db.UnsignedInt
  discount      Int     @default(0) @db.UnsignedInt
  shippingCost  Int     @default(0) @map("shipping_cost") @db.UnsignedInt
  tax           Int     @default(0) @db.UnsignedInt
  total         Int     @default(0) @db.UnsignedInt
  couponCode    String? @map("coupon_code") @db.VarChar(50)
  shippingTitle String? @map("shipping_title") @db.VarChar(255)
  shippingEta   String? @map("shipping_eta") @db.VarChar(255)

  adminNote   String?   @map("admin_note") @db.Text
  ip          String?   @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  paidAt      DateTime? @map("paid_at") @db.Timestamp(0)
  shippedAt   DateTime? @map("shipped_at") @db.Timestamp(0)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamp(0)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamp(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull, map: "orders_user_id_foreign")
  addressRef      Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull, map: "orders_address_id_foreign")
  shippingMethod  ShippingMethod?      @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull, map: "orders_shipping_method_id_foreign")
  coupon          Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull, map: "orders_coupon_id_foreign")
  province        Province             @relation(fields: [provinceId], references: [id], map: "orders_province_id_foreign")
  city            City                 @relation(fields: [cityId], references: [id], map: "orders_city_id_foreign")
  items           OrderItem[]
  statusHistories OrderStatusHistory[]
  payments        Payment[]
  shipments       Shipment[]
  couponUsages    CouponUsage[]

  @@index([userId], map: "orders_user_id_index")
  @@index([addressId], map: "orders_address_id_index")
  @@index([shippingMethodId], map: "orders_shipping_method_id_index")
  @@index([couponId], map: "orders_coupon_id_index")
  @@index([provinceId], map: "orders_province_id_index")
  @@index([cityId], map: "orders_city_id_index")
  @@index([status], map: "orders_status_index")
  @@index([paymentStatus], map: "orders_payment_status_index")
  @@index([createdAt], map: "orders_created_at_index")
  @@map("orders")
}

model OrderItem {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId     BigInt   @map("order_id") @db.UnsignedBigInt
  productId   BigInt?  @map("product_id") @db.UnsignedBigInt
  variantId   BigInt?  @map("variant_id") @db.UnsignedBigInt
  productName String   @map("product_name") @db.VarChar(255)
  productSlug String?  @map("product_slug") @db.VarChar(191)
  sku         String?  @db.VarChar(64)
  colorName   String?  @map("color_name") @db.VarChar(100)
  colorHex    String?  @map("color_hex") @db.VarChar(9)
  sizeLabel   String?  @map("size_label") @db.VarChar(100)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  unitPrice   Int      @map("unit_price") @db.UnsignedInt
  quantity    Int      @db.UnsignedInt
  total       Int      @db.UnsignedInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "order_items_order_id_foreign")
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull, map: "order_items_product_id_foreign")
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, map: "order_items_variant_id_foreign")

  @@index([orderId], map: "order_items_order_id_index")
  @@index([productId], map: "order_items_product_id_index")
  @@index([variantId], map: "order_items_variant_id_index")
  @@map("order_items")
}

/// order timeline (who changed what, when)
model OrderStatusHistory {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orderId           BigInt       @map("order_id") @db.UnsignedBigInt
  adminId           BigInt?      @map("admin_id") @db.UnsignedBigInt
  fromStatus        OrderStatus? @map("from_status")
  status            OrderStatus
  note              String?      @db.VarChar(1000)
  isCustomerVisible Boolean      @default(true) @map("is_customer_visible")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "order_status_histories_order_id_foreign")
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull, map: "order_status_histories_admin_id_foreign")

  @@index([orderId], map: "order_status_histories_order_id_index")
  @@index([adminId], map: "order_status_histories_admin_id_index")
  @@map("order_status_histories")
}

/// online-payment transactions (one order may have several attempts)
model Payment {
  id            BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  orderId       BigInt            @map("order_id") @db.UnsignedBigInt
  userId        BigInt?           @map("user_id") @db.UnsignedBigInt
  gateway       String            @db.VarChar(32) // zarinpal | mock | cod
  amount        Int               @db.UnsignedInt // Toman
  status        TransactionStatus @default(pending)
  authority     String?           @db.VarChar(191) // gateway token
  refId         String?           @map("ref_id") @db.VarChar(191) // bank reference / trace number
  cardPan       String?           @map("card_pan") @db.VarChar(32) // masked card
  cardHash      String?           @map("card_hash") @db.VarChar(255)
  description   String?           @db.VarChar(500)
  failureReason String?           @map("failure_reason") @db.VarChar(500)
  meta          Json? // raw gateway responses
  ip            String?           @db.VarChar(45)
  paidAt        DateTime?         @map("paid_at") @db.Timestamp(0)
  verifiedAt    DateTime?         @map("verified_at") @db.Timestamp(0)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "payments_order_id_foreign")
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull, map: "payments_user_id_foreign")

  @@index([orderId], map: "payments_order_id_index")
  @@index([userId], map: "payments_user_id_index")
  @@index([authority], map: "payments_authority_index")
  @@index([status], map: "payments_status_index")
  @@map("payments")
}

/// parcel handed to a carrier — carries the postal tracking code
model Shipment {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  orderId          BigInt         @map("order_id") @db.UnsignedBigInt
  shippingMethodId BigInt?        @map("shipping_method_id") @db.UnsignedBigInt
  adminId          BigInt?        @map("admin_id") @db.UnsignedBigInt
  carrier          String?        @db.VarChar(100)
  trackingCode     String?        @map("tracking_code") @db.VarChar(100)
  trackingUrl      String?        @map("tracking_url") @db.VarChar(500)
  status           ShipmentStatus @default(pending)
  note             String?        @db.VarChar(1000)
  shippedAt        DateTime?      @map("shipped_at") @db.Timestamp(0)
  deliveredAt      DateTime?      @map("delivered_at") @db.Timestamp(0)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "shipments_order_id_foreign")
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull, map: "shipments_shipping_method_id_foreign")
  admin          Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull, map: "shipments_admin_id_foreign")

  @@index([orderId], map: "shipments_order_id_index")
  @@index([shippingMethodId], map: "shipments_shipping_method_id_index")
  @@index([adminId], map: "shipments_admin_id_index")
  @@index([trackingCode], map: "shipments_tracking_code_index")
  @@map("shipments")
}

// ═════════════════════════════ system ═════════════════════════════

model Setting {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key       String   @unique(map: "settings_key_unique") @db.VarChar(100)
  value     String?  @db.Text
  type      String   @default("string") @db.VarChar(20) // string | number | boolean | text
  group     String   @default("general") @db.VarChar(50)
  label     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("settings")
}
